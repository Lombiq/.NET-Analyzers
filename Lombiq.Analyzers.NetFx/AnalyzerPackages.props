<Project>

  <!-- The Meziantou.Analyzer package needs to be on frozen on a lower version for .NET Framework projects but can be
       up-to-date for everything else. See https://github.com/meziantou/Meziantou.Analyzer/issues/791). -->

  <ItemGroup>
    <AnalyzerPackage Include="Meziantou.Analyzer" Version="3.0.312"/>
  </ItemGroup>

  <ItemGroup Condition="'$(NuGetBuild)' != 'true'">
    <PackageReference Include="@(AnalyzerPackage)" Version="%(Version)" IncludeInPackage="true">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers;</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
