<Project>
  <ItemGroup>
    <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)Lombiq.Analyzers.OrchardCore.globalconfig" />
  </ItemGroup>

  <!-- The order matters here, because the props file in "Lombiq.Analyzers" is the one that convert the
       "AnalyzerPackage" items into "PackageReference" so it has to be the last in chain. -->
  <Import Project="$(MSBuildThisFileDirectory)AnalyzerPackages.props" />
  <Import Project="$(MSBuildThisFileDirectory)../Lombiq.Analyzers/Build.props" Condition="'$(NuGetBuild)' != 'true'" />
</Project>
